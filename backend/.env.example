# Copy this file to .env and fill in real values. Never commit .env.

# API port (the Vite dev server proxies /api and /uploads here)
PORT=4000

# Postgres (docker-compose.yml starts one on host port 5434)
DATABASE_URL=postgres://apsl:apsl_dev_password@127.0.0.1:5434/apsl

# Long random string used to sign admin session tokens.
# Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created/updated by `npm run seed`.
# Use a strong password (12+ characters). It is stored only as a bcrypt hash.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Set to true in production behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Allowed browser origin for CORS in production (leave empty in dev, Vite proxies)
CORS_ORIGIN=
